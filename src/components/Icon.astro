---
import LucideArrowUpRight from "virtual:icons/lucide/arrow-up-right"
import LucideChevronLeft from "virtual:icons/lucide/chevron-left"
import MdiEmail from "virtual:icons/mdi/email"
import MdiGithub from "virtual:icons/mdi/github"
import MdiLinkVariant from "virtual:icons/mdi/link-variant"
import MdiLinkedin from "virtual:icons/mdi/linkedin"
import MdiTwitter from "virtual:icons/mdi/twitter"
import type { HTMLAttributes } from "astro/types"

const icons = {
  "lucide:arrow-up-right": LucideArrowUpRight,
  "lucide:chevron-left": LucideChevronLeft,
  "mdi:email": MdiEmail,
  "mdi:github": MdiGithub,
  "mdi:linkedin": MdiLinkedin,
  "mdi:link-variant": MdiLinkVariant,
  "mdi:twitter": MdiTwitter
}

export type IconName = keyof typeof icons

interface Props extends HTMLAttributes<"svg"> {
  name: IconName | (string & {})
  class?: string
}

const { name, class: className } = Astro.props

if (!name) {
  throw new Error("Missing required 'name' prop for Icon")
}

const Icon = icons[name as IconName]

if (!Icon) {
  throw new Error(
    `Icon '${name} is not registered. Add it to src/component/Icon.astro.`
  )
}
---

<Icon className={className} />
