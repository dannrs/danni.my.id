---
import { Image } from "astro:assets"
import Icon from "@/components/Icon.astro"
import { Button } from "@/components/ui/button"
import { SITE_CONFIG } from "@/constants"
---

<section class="flex flex-col items-center justify-center pb-10 pt-2">
  <Image src="/hero.svg" alt="hero image" width={300} height={300} />
  <h1 class="font-heading text-3xl sm:text-4xl">{SITE_CONFIG.name}</h1>
  <p class="max-w-lg py-2 text-center text-foreground-3 sm:text-lg">
    {SITE_CONFIG.description}
  </p>
  <div class="pt-1">
    <a
      href="/about#contact"
      aria-label="Go to the contact page"
    >
      <Button className="mr-4">
        Contact Me<Icon
          name="lucide:arrow-up-right"
          class="ml-1 size-[0.85rem]"
        />
      </Button>
    </a>
    <a href="/projects" aria-label="Go to the projects page">
      <Button variant="outline">Projects</Button>
    </a>
  </div>
</section>
